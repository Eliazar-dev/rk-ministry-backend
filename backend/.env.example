DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
# Your deployed React site(s), comma separated
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# Used for the link inside password-reset emails
FRONTEND_URL=https://your-frontend.vercel.app

# Postgres (required on Vercel — sqlite is not persistent there)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Google sign-in: OAuth "Web application" client ID (same value goes in the frontend as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Cloudinary (admin uploads for covers / PDFs)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email (order + donation receipts). Without these, emails print to the log.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# M-Pesa Daraja STK push. Leave empty to run in simulate mode (auto-confirms after ~25s).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-backend.vercel.app/api/mpesa/callback/
