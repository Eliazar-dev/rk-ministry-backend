{
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/" }],
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python manage.py migrate",
  "version": 2
}
